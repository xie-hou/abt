{
  "name": "dot-galaxy",
  "version": 1,
  "description": "黄金角螺旋排布的发光点阵：内圈转得快、外圈转得慢，再叠一层从中心向外的波纹",
  "params": {
    "count":      {"label": "Count",       "type": "int",   "default": 4000, "min": 1, "max": 50000, "desc": "点数"},
    "radius":     {"label": "Radius",      "type": "float", "default": 6.0, "min": 0.1, "max": 100, "desc": "半径（米）"},
    "twist":      {"label": "Twist",       "type": "float", "default": 0.8, "min": -10, "max": 10, "desc": "旋转速度（弧度/秒，按 1/(1+r) 衰减）"},
    "amplitude":  {"label": "Amplitude",   "type": "float", "default": 0.5, "min": 0, "max": 5, "desc": "波高（米）"},
    "frequency":  {"label": "Frequency",   "type": "float", "default": 1.3, "min": 0, "max": 20, "desc": "波纹密度"},
    "waveSpeed":  {"label": "Wave Speed",  "type": "float", "default": 2.2, "min": -20, "max": 20, "desc": "波纹向外扩散的速度"},
    "dotSize":    {"label": "Dot Size",    "type": "float", "default": 0.035, "min": 0.001, "max": 1, "desc": "点的半径（米）"},
    "colorInner": {"label": "Inner Color", "type": "color", "default": [1.0, 0.42, 0.12], "desc": "中心颜色（线性）"},
    "colorOuter": {"label": "Outer Color", "type": "color", "default": [0.08, 0.3, 1.0], "desc": "边缘颜色（线性）"},
    "glow":       {"label": "Glow",        "type": "float", "default": 3.0, "min": 0, "max": 50, "desc": "发光强度"}
  }
}
